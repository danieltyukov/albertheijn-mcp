{
  "name": "albertheijn-mcp",
  "version": "0.1.0",
  "description": "MCP server for Albert Heijn: products, bonus, basket and orders, delivery slots, shopping lists, receipts, Allerhande recipes and meal prep planning for Claude, ChatGPT, Cursor and any other MCP client.",
  "type": "module",
  "license": "MIT",
  "author": "Daniel Tyukov",
  "mcpName": "io.github.danieltyukov/albertheijn-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieltyukov/albertheijn-mcp.git"
  },
  "homepage": "https://danieltyukov.github.io/albertheijn-mcp/",
  "bugs": {
    "url": "https://github.com/danieltyukov/albertheijn-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "albert-heijn",
    "ah",
    "appie",
    "groceries",
    "supermarket",
    "recipes",
    "meal-prep",
    "allerhande",
    "claude",
    "chatgpt",
    "cursor"
  ],
  "bin": {
    "albertheijn-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "test:live": "AH_MCP_LIVE=1 vitest run tests/live",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "docs:tools": "tsx scripts/generate-tool-docs.ts",
    "prepack": "npm run build",
    "test:live:account": "AH_MCP_LIVE=1 AH_MCP_LIVE_ACCOUNT=1 vitest run tests/live",
    "check:install": "node scripts/check-install.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
